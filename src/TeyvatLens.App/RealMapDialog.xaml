<Window x:Class="TeyvatLens.App.RealMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карта Тейвата"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Реальная карта" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,6,0,16"
                       TextWrapping="Wrap"
                       Text="Загрузите изображение карты Тейвата — например, скриншот интерактивной карты на максимальном приближении. Точки из JSON задаются в пикселях этого изображения."/>

            <TextBlock Text="Файл карты" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" MinWidth="88" Click="OnBrowse"/>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Пикселей на метр" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PpmBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Масштаб: 1 px = … м" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MetersPerPixelText" Text="1,00 м" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Начало карты по X, м" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="OriginXBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Начало карты по Z, м" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="OriginZBox"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,14,0,0"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Text="Ориентир: на скриншоте интерактивной карты удобно измерить расстояние между двумя телепортами и подобрать масштаб так, чтобы расстояние совпало с игровым. Начало координат можно оставить нулевым."/>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Click="OnCancel" MinWidth="96"/>
                <Button Content="Сохранить" Style="{StaticResource AccentButton}" Margin="10,0,0,0" MinWidth="110" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
