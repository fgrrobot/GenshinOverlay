<Window x:Class="TeyvatLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TeyvatLens.App.Controls"
        Title="Teyvat Lens — прототип"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="✦"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Teyvat Lens" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Прототип оверлея навигации" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource MutedBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel"
                                       Text="Пауза"
                                       Margin="8,0,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton"
                            Content="Старт"
                            Style="{StaticResource AccentButton}"
                            Margin="12,0,0,0"
                            MinWidth="104"
                            Click="OnStartPause"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <controls:MapView x:Name="Map"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="16"
                            Background="#D90E1117"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9">
                        <StackPanel>
                            <TextBlock x:Name="ModeText" Text="Демо-мир" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock x:Name="CoordsText"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <controls:CompassControl x:Name="Compass"
                                             Width="78" Height="78"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="16"/>

                    <Border x:Name="HintBanner"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Background="#E60E1117"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HintArrow"
                                       Text="➤"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       RenderTransformOrigin="0.5,0.5"/>
                            <TextBlock x:Name="HintText"
                                       Text="Целей рядом нет"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="РЕЖИМ" Style="{StaticResource CardTitle}"/>
                            <Border Background="{StaticResource BgBrush}"
                                    CornerRadius="10"
                                    Padding="3"
                                    Margin="0,10,0,0">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ScreenModeRadio"
                                                 GroupName="Mode"
                                                 Style="{StaticResource Segment}"
                                                 Content="Реальный мир"
                                                 IsChecked="True"
                                                 Checked="OnModeChanged"/>
                                    <RadioButton x:Name="DemoModeRadio"
                                                 GroupName="Mode"
                                                 Style="{StaticResource Segment}"
                                                 Content="Демо-мир"
                                                 Checked="OnModeChanged"/>
                                </UniformGrid>
                            </Border>
                            <Button x:Name="CalibrateButton"
                                    Content="Настроить область захвата"
                                    Margin="0,10,0,0"
                                    Click="OnCalibrate"/>
                            <TextBlock x:Name="CaptureInfoText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RealMapCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="КАРТА ТЕЙВАТА" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,8,0,10"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Text="Скачайте карту и настоящие телепорты с интерактивной карты Тейвата — или загрузите свои файлы вручную."/>
                            <Button x:Name="AutoMapButton"
                                    Content="Загрузить с карты Тейвата"
                                    Style="{StaticResource AccentButton}"
                                    Click="OnLoadFromGenshinMap"/>
                            <Button x:Name="LoadMapButton"
                                    Content="Своё изображение карты…"
                                    Margin="0,8,0,0"
                                    Click="OnLoadRealMap"/>
                            <Button x:Name="ImportPointsButton"
                                    Content="Свои точки (JSON)…"
                                    Margin="0,8,0,0"
                                    Click="OnImportPoints"/>
                            <TextBlock x:Name="RealMapInfoText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Радиус поиска" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="RadiusValueText"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider x:Name="RadiusSlider"
                                    Minimum="30"
                                    Maximum="250"
                                    Value="120"
                                    Margin="0,4,0,0"
                                    ValueChanged="OnRadiusChanged"/>
                            <TextBlock Text="Тип объектов"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,12,0,6"/>
                            <ComboBox x:Name="KindFilterCombo"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="OnKindFilterChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ПРИВЯЗКА К ТЕЛЕПОРТУ" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,8,0,10"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Text="Одометрия относительна: после потери сигнала нужна ручная привязка к известной точке."/>
                            <ComboBox x:Name="WaypointCombo" DisplayMemberPath="Name"/>
                            <Button x:Name="SnapButton"
                                    Content="Привязать позицию"
                                    Style="{StaticResource AccentButton}"
                                    Margin="0,10,0,0"
                                    Click="OnSnap"/>
                            <TextBlock x:Name="SnapStatusText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="БЛИЖАЙШИЕ ОБЪЕКТЫ"
                                           Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="NearbyCountText"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <ListBox x:Name="MarkerList"
                                     Height="230"
                                     Margin="0,10,0,0"
                                     SelectionChanged="OnMarkerSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="#141A23"
                                                    BorderBrush="{Binding Accent}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}"
                                                       Width="21" Height="21"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DistanceText}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DirectionText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="CollectButton"
                                    Content="Отметить собранным"
                                    Margin="0,10,0,0"
                                    IsEnabled="False"
                                    Click="OnCollect"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DemoCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ДЕМОНСТРАЦИЯ" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Потерять сигнал миникарты"/>
                                    <TextBlock Text="Проверка перехода в Lost"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"/>
                                </StackPanel>
                                <ToggleButton x:Name="LostSwitch"
                                              Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Checked="OnLostToggled"
                                              Unchecked="OnLostToggled"/>
                            </Grid>
                            <Button x:Name="ResetButton"
                                    Content="Сбросить прогресс"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,14,0,0"
                                    Click="OnReset"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="4,14,4,6"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Прототип: относительная локализация по миникарте и ручная привязка к телепорту. Абсолютная локализация по атласу — в следующих версиях."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,9">
            <Grid>
                <TextBlock x:Name="FooterLeft" Style="{StaticResource MutedText}" FontSize="11.5"/>
                <TextBlock x:Name="FooterRight"
                           Style="{StaticResource MutedText}"
                           FontSize="11.5"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
