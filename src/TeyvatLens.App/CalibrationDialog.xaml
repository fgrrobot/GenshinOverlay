<Window x:Class="TeyvatLens.App.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Область захвата миникарты"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Область захвата" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap"
                       Text="Квадрат вокруг миникарты в пикселях экрана. Запустите игру в оконном режиме без рамки и подберите область так, чтобы в неё попадала только миникарта."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="X, px" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="XBox"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Y, px" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="YBox"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="Размер, px" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="SizeBox"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="Пикселей на метр" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PpmBox"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Click="OnCancel" MinWidth="96"/>
                <Button Content="Сохранить" Style="{StaticResource AccentButton}" Margin="10,0,0,0" MinWidth="110" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
